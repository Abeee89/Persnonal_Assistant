# Personal Activity — environment (copy to .env.local)

# Core
DATA_DIR=./data
PORT=3000
HOSTNAME=127.0.0.1
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_BACKEND=local

# Auth (Phase 2)
AUTH_ENABLED=false
# AUTH_SECRET=

# AI (Phase 3)
AI_ENABLED=false
